---
import catalog from '../data/catalog.json';
---

<div class="product-table" data-products={JSON.stringify(catalog)}>
  <div class="product-table__controls">
    <label class="search">
      Search:
      <input type="search" placeholder="Search products…" aria-label="Search products" />
    </label>
    <button type="button" class="reset">↺ Reset</button>
  </div>

  <table>
    <thead>
      <tr>
        <th data-key="title" class="sortable">Name</th>
        <th data-key="pack" class="sortable">Summary</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>

  <p class="product-table__empty" hidden>No products matched your search.</p>

  <nav class="product-table__pagination" aria-label="Table pages"></nav>
</div>

<style>
  .product-table__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-family: var(--font-heading);
  }

  .search input {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 10px 14px;
    border: 1px solid #dde3e7;
    border-radius: 6px;
    min-width: 240px;
  }

  .reset {
    font-family: var(--font-heading);
    font-weight: 700;
    background: none;
    border: none;
    color: var(--color-primary);
    cursor: pointer;
    font-size: 15px;
  }

  .reset:hover {
    text-decoration: underline;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead th {
    text-align: left;
    font-family: var(--font-heading);
    font-weight: 700;
    padding: 14px 16px;
    border-bottom: 2px solid #eef1f3;
  }

  th.sortable {
    cursor: pointer;
    user-select: none;
  }

  th.sortable::after {
    content: '⇅';
    margin-left: 6px;
    color: var(--color-muted);
    font-size: 12px;
  }

  th.sortable[data-dir='asc']::after {
    content: '↑';
    color: var(--color-primary);
  }

  th.sortable[data-dir='desc']::after {
    content: '↓';
    color: var(--color-primary);
  }

  /*
    Rows are injected at runtime via innerHTML, so Astro's scoped
    `data-astro-cid` attribute never lands on them — these selectors
    must stay global to actually reach the generated <tr>/<td>.
  */
  .product-table :global(tbody tr:nth-child(odd)) {
    background: #eeeeee;
  }

  .product-table :global(tbody tr:nth-child(even)) {
    background: var(--color-white);
  }

  .product-table :global(tbody td) {
    padding: 14px 16px;
  }

  .product-table :global(tbody td:first-child a) {
    color: var(--color-teal);
    font-weight: 600;
  }

  .product-table :global(tbody td:first-child a:hover) {
    color: var(--color-primary);
  }

  .product-table__empty {
    text-align: center;
    padding: 32px;
    color: var(--color-muted);
  }

  .product-table__pagination {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .product-table__pagination button {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    border: 1px solid #dde3e7;
    background: var(--color-white);
    color: var(--color-text);
    border-radius: 6px;
    padding: 8px 14px;
    cursor: pointer;
  }

  .product-table__pagination button[aria-current='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .product-table__pagination button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (max-width: 600px) {
    .product-table__controls {
      flex-direction: column;
      align-items: flex-start;
    }

    .search input {
      min-width: 0;
      width: 100%;
    }
  }
</style>

<script>
  type Product = { slug: string; title: string; pack: string | null };

  const root = document.querySelector<HTMLElement>('.product-table')!;
  const products: Product[] = JSON.parse(root.dataset.products ?? '[]');

  const searchInput = root.querySelector<HTMLInputElement>('input[type="search"]')!;
  const resetButton = root.querySelector<HTMLButtonElement>('.reset')!;
  const tbody = root.querySelector('tbody')!;
  const emptyMessage = root.querySelector<HTMLElement>('.product-table__empty')!;
  const pagination = root.querySelector<HTMLElement>('.product-table__pagination')!;
  const headers = root.querySelectorAll<HTMLTableCellElement>('th.sortable');

  const PAGE_SIZE = 25;
  let query = '';
  let sortKey: keyof Product = 'title';
  let sortDir: 'asc' | 'desc' = 'asc';
  let page = 1;

  function getFiltered(): Product[] {
    const q = query.trim().toLowerCase();
    let rows = q
      ? products.filter(
          (p) => p.title.toLowerCase().includes(q) || (p.pack ?? '').toLowerCase().includes(q)
        )
      : products.slice();

    rows.sort((a, b) => {
      const av = (a[sortKey] ?? '').toString().toLowerCase();
      const bv = (b[sortKey] ?? '').toString().toLowerCase();
      const cmp = av.localeCompare(bv);
      return sortDir === 'asc' ? cmp : -cmp;
    });

    return rows;
  }

  function render() {
    const rows = getFiltered();
    const totalPages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
    page = Math.min(page, totalPages);
    const start = (page - 1) * PAGE_SIZE;
    const pageRows = rows.slice(start, start + PAGE_SIZE);

    tbody.innerHTML = pageRows
      .map(
        (p) => `
          <tr>
            <td><a href="/product/${p.slug}/">${p.title}</a></td>
            <td>${p.pack ?? ''}</td>
          </tr>
        `
      )
      .join('');

    emptyMessage.hidden = pageRows.length > 0;

    headers.forEach((th) => {
      if (th.dataset.key === sortKey) th.dataset.dir = sortDir;
      else th.removeAttribute('data-dir');
    });

    renderPagination(totalPages);
  }

  function renderPagination(totalPages: number) {
    pagination.innerHTML = '';
    if (totalPages <= 1) return;

    const addButton = (label: string, target: number, opts: { current?: boolean; disabled?: boolean } = {}) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      if (opts.current) btn.setAttribute('aria-current', 'true');
      if (opts.disabled) btn.disabled = true;
      btn.addEventListener('click', () => {
        page = target;
        render();
      });
      pagination.appendChild(btn);
    };

    addButton('← Prev', page - 1, { disabled: page === 1 });

    const windowSize = 2;
    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || Math.abs(p - page) <= windowSize) {
        addButton(String(p), p, { current: p === page });
      } else if (Math.abs(p - page) === windowSize + 1) {
        const span = document.createElement('span');
        span.textContent = '…';
        span.style.padding = '8px 4px';
        span.style.color = 'var(--color-muted)';
        pagination.appendChild(span);
      }
    }

    addButton('Next →', page + 1, { disabled: page === totalPages });
  }

  searchInput.addEventListener('input', () => {
    query = searchInput.value;
    page = 1;
    render();
  });

  resetButton.addEventListener('click', () => {
    query = '';
    searchInput.value = '';
    sortKey = 'title';
    sortDir = 'asc';
    page = 1;
    render();
  });

  headers.forEach((th) => {
    th.addEventListener('click', () => {
      const key = th.dataset.key as keyof Product;
      if (sortKey === key) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        sortKey = key;
        sortDir = 'asc';
      }
      page = 1;
      render();
    });
  });

  render();
</script>
