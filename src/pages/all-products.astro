---
import Layout from '../layouts/Layout.astro';
import ProductTable from '../components/ProductTable.astro';
import { Image } from 'astro:assets';
import heroShop from '../assets/site/hero-shop.jpg';
---

<Layout title="All Products – Janatha Pharma" description="Browse Janatha Pharma's full catalog of government-approved generic medicines. Search and sort to find what you need.">
  <section class="page-header">
    <Image src={heroShop} alt="" width={1920} height={500} class="page-header__bg" />
    <div class="page-header__overlay"></div>
    <div class="container page-header__inner">
      <h1>All Products</h1>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">🏠 Home</a> <span>›</span> <span>All Products</span>
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="catalog-title">All Products</h2>
      <ProductTable />
    </div>
  </section>
</Layout>

<style>
  .page-header {
    position: relative;
    min-height: 360px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-white);
  }

  .page-header :global(.page-header__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .page-header__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(6, 42, 63, 0.6), rgba(25, 190, 111, 0.35));
    z-index: 1;
  }

  .page-header__inner {
    position: relative;
    z-index: 2;
  }

  .page-header h1 {
    color: var(--color-white);
    font-size: 56px;
    margin-bottom: 16px;
  }

  .breadcrumb {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--color-white);
  }

  .breadcrumb a:hover {
    color: var(--color-secondary);
  }

  .breadcrumb span {
    color: #d8e3e8;
  }

  .catalog-title {
    font-size: 32px;
    margin-bottom: 28px;
  }

  @media (max-width: 700px) {
    .page-header h1 {
      font-size: 38px;
    }
  }
</style>
